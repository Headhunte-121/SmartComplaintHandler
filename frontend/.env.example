# ==============================================================================
# Smart Complaint Handler - Frontend Environment Configuration (Vercel + Vite)
# ==============================================================================

# Relative /api/v1 uses Vercel rewrites (frontend/vercel.json) to avoid CORS preflight overhead
VITE_API_BASE_URL=/api/v1

# Google Cloud OAuth 2.0 Web Client ID (Authorized JavaScript Origins: your Vercel domain)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
