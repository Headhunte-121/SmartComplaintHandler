# ==============================================================================
# Smart Complaint Handler - Production Backend Environment Configuration
# Hosted on: Vercel Serverless + Supabase PostgreSQL + Google Workspace OAuth2
# ==============================================================================

PROJECT_NAME="Smart Complaint Handler"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# ------------------------------------------------------------------------------
# 1. Database Connection String (Supabase Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# Recommended for Vercel Serverless: Use Supabase Transaction Pooler (port 6543) or Session Pooler (port 5432)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. JWT & Session Cryptography
# ------------------------------------------------------------------------------
SECRET_KEY="replace-with-64-char-cryptographic-random-secret-in-vercel-env"
REFRESH_SECRET_KEY="replace-with-64-char-cryptographic-refresh-secret-in-vercel-env"
ACCESS_TOKEN_EXPIRE_HOURS=24
REMEMBER_ME_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10

# ------------------------------------------------------------------------------
# 3. Google Workspace OAuth 2.0 / OIDC SSO (@iiitnr.edu.in)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_ALLOWED_DOMAIN="iiitnr.edu.in"
GOOGLE_STRICT_TOKEN_VERIFY=True

# ------------------------------------------------------------------------------
# 4. Security & CORS Policy
# ------------------------------------------------------------------------------
ALLOW_UNREGISTERED_LOGIN_PROVISIONING=False
EXPOSE_DEV_OTP_IN_RESPONSE=False
CORS_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:5173"
